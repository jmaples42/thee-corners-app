rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // The invitee's verified sign-in number (Firebase phone auth puts it on the token).
    function hasInvite(cornerId) {
      return isSignedIn() && request.auth.token.phone_number != null
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.phone_number + '_' + cornerId));
    }

    match /corners/{cornerId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      // Creator starts alone; everyone else joins by accepting an invite.
      allow create: if isSignedIn() && request.resource.data.memberUids == [request.auth.uid];
      allow update: if isSignedIn() && (
        // Members can update the corner (e.g. lastActivityAt) but not change who is in it.
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.memberUids == resource.data.memberUids)
        // An invitee can add exactly themselves, up to the free 5-person limit.
        || (hasInvite(cornerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() <= 5)
      );

      match /posts/{postId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/corners/$(cornerId)).data.memberUids;
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text.size() <= 500
                      && request.auth.uid in get(/databases/$(database)/documents/corners/$(cornerId)).data.memberUids;
        allow update: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/corners/$(cornerId)).data.memberUids
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      }
    }

    match /releases/{releaseId} {
      allow read: if true;    // public — this is the marketing/SEO-facing content
      allow create, delete: if false;  // only the admin SDK (publish-releases script) creates releases
      // commentCount is bumped by any signed-in user's comment create/delete — restrict updates to that one field
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']);

      match /comments/{commentId} {
        allow read: if true;  // public, same as releases
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update: if isSignedIn() && (
                        (resource.data.uid == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
                          && request.resource.data.text.size() > 0
                          && request.resource.data.text.size() <= 500)
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                      );
        allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Corner invites, keyed `${phone}_${cornerId}`. Readable by the invitee (matched on
    // their verified number) and the inviter; accepting = join the corner + delete.
    match /invites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.phone == request.auth.token.phone_number
        || resource.data.invitedByUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['cornerId', 'cornerName', 'phone', 'invitedByUid', 'invitedByUsername', 'createdAt'])
        && request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$')
        && request.resource.data.cornerName.size() <= 40
        && inviteId == request.resource.data.phone + '_' + request.resource.data.cornerId
        && request.auth.uid in get(/databases/$(database)/documents/corners/$(request.resource.data.cornerId)).data.memberUids;
      allow delete: if isSignedIn() && (
        resource.data.phone == request.auth.token.phone_number
        || resource.data.invitedByUid == request.auth.uid);
    }

    // One doc per published weekly issue (id = weekOf); written by the publish script.
    match /issues/{weekOf} {
      allow read: if true;
      allow write: if false;
    }

    // "Save to my Corners" — a personal bookmark, doc id is `${uid}_${releaseId}`.
    match /savedReleases/{savedId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && savedId == request.resource.data.uid + '_' + request.resource.data.releaseId;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
